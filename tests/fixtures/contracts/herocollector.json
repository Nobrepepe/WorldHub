            { "id": "col_reward_character", "label": "Reward skin — character", "type": "entityRef", "entityTypes": ["character"], "required": false },
            { "id": "col_reward_skin_name", "label": "Reward skin — name", "type": "shortText", "required": false, "maxLength": 80 }
          ]
        },
        { "id": "hc_full_reward_character", "label": "Full-archive reward — character", "type": "entityRef", "entityTypes": ["character"], "required": false },
        { "id": "hc_full_reward_skin_name", "label": "Full-archive reward — skin name", "type": "shortText", "required": false, "maxLength": 80 }
      ],
      "assetSets": [
        { "id": "hc_world_cover", "label": "World cover", "kinds": ["image"], "roles": ["world.cover"], "recipes": ["landscape_16x9"], "exact": 1 },
        { "id": "hc_hq_art", "label": "Headquarters art", "kinds": ["image"], "roles": ["world.background"], "recipes": ["landscape_16x9"], "min": 0, "max": 1 },
        {
          "id": "hc_chapter_art",
          "label": "Chapter art — three, in order",
          "kinds": ["image"],
          "roles": ["scene.key_art"],
          "recipes": ["landscape_16x9"],
          "min": 0,
          "max": 3,
          "hint": "One image per campaign chapter, in chapter order."
        }
      ]
    },
    {
      "id": "hc_characters",
      "label": "Characters",
      "entityTypes": ["character"],
      "min": 1,
      "ordered": true,
      "hint": "Collectible characters. Name, summary, and lore come from the canonical profile; these fields configure gameplay presentation.",
      "fields": [
        { "id": "hc_archetype", "label": "Archetype", "type": "enum", "required": true, "options": [
          { "value": "leader", "label": "Leader" },
          { "value": "caretaker", "label": "Caretaker" },
          { "value": "achiever", "label": "Achiever" },
          { "value": "rebel", "label": "Rebel" },
          { "value": "dreamer", "label": "Dreamer" },
          { "value": "freespirit", "label": "Free Spirit" }
        ] },
        { "id": "hc_tier", "label": "Acquisition tier", "type": "enum", "required": true, "options": [
          { "value": "minor", "label": "Minor" },
          { "value": "medium", "label": "Medium" },
          { "value": "major", "label": "Major" }
        ] },
        { "id": "hc_starting", "label": "Starting character", "type": "boolean", "required": false },
        { "id": "hc_faction", "label": "Faction id", "type": "shortText", "required": false, "maxLength": 60, "hint": "One of the faction ids declared in this production's Factions list." },
        { "id": "hc_extra_tags", "label": "Extra tag ids", "type": "list", "required": false, "maxItems": 8, "item": { "id": "hc_tag", "label": "Tag id", "type": "shortText", "maxLength": 60 }, "hint": "Tag ids from the bundled tag vocabulary, e.g. tag_scholar." },
        { "id": "hc_glyph", "label": "Glyph", "type": "shortText", "required": false, "maxLength": 4 },
        { "id": "hc_color", "label": "Accent color", "type": "color", "required": false },
        {
          "id": "hc_equipment",
          "label": "Equipment lines",
          "type": "list",
          "required": false,
          "maxItems": 6,
          "hint": "One entry per slot: attire, tool, accessory, keepsake, emblem, signature.",
          "fields": [
            { "id": "equip_slot", "label": "Slot", "type": "enum", "required": true, "options": [
              { "value": "attire", "label": "Attire" },
              { "value": "tool", "label": "Tool" },
              { "value": "accessory", "label": "Accessory" },
              { "value": "keepsake", "label": "Keepsake" },
              { "value": "emblem", "label": "Emblem" },
              { "value": "signature", "label": "Signature" }
