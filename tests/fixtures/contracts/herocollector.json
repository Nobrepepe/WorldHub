  "assetSets": [
    { "id": "hc_expedition_art", "label": "Expedition board art", "kinds": ["image"], "roles": ["scene.key_art"], "recipes": ["landscape_16x9"], "min": 0, "max": 1 }
  ],
  "documents": { "mode": "linked" },
  "requiredRecipes": ["landscape_16x9", "square", "thumbnail_square", "portrait_9x16"]
}
