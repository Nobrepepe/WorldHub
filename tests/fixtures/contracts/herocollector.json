        {
          "id": "hc_skins",
          "label": "Skins",
          "type": "list",
          "required": false,
          "maxItems": 10,
          "fields": [
            { "id": "skin_id", "label": "Skin id", "type": "shortText", "required": true, "maxLength": 60, "hint": "Stable id referenced by archive rewards." },
            { "id": "skin_name", "label": "Skin name", "type": "shortText", "required": true, "maxLength": 120 },
            { "id": "skin_art", "label": "Art", "type": "assetRef", "required": false, "assetKinds": ["image"], "recipes": ["portrait_9x16"] }
