{
  "format": "world-hub-application-contract",
  "contractFormatVersion": 1,
  "appType": "hero-collector.content-pack",
  "name": "Hero Collector \u2014 Creative Manifest",
  "description": "The worlds and people of a Hero Collector game: who exists, in what order, what they are called, and what they look like. Nothing here decides anything mechanical. Power thresholds, material families and grades, node rewards, relic and hero-reveal positions, recruitment cost, Expedition routes, Crisis Fronts and Mastery milestones are all computed by the game from its own balance files \u2014 so renaming a node can never move its Power, and adding a world needs nothing here but the world.",
  "supportedProtocolVersions": [
    1,
    2
  ],
  "productionFields": [
    {
      "id": "hc_main_chapters",
      "label": "Main Campaign chapters",
      "section": "Main campaign",
      "type": "list",
      "required": true,
      "minItems": 1,
      "maxItems": 20,
      "hint": "The opening track, shared by every world. The game introduces each world's first five heroes along it, so it needs one chapter per two published worlds \u2014 with four worlds, publish at least two chapters.",
      "fields": [
        {
          "id": "chapter_title",
          "label": "Chapter title",
          "type": "shortText",
          "required": false,
          "maxLength": 120
        },
        {
          "id": "chapter_art",
          "label": "Chapter backdrop",
          "type": "assetRef",
          "required": false,
          "assetKinds": [
            "image"
          ],
          "assetRoles": [
            "world.background"
          ],
          "recipes": [
            "tile_16x9"
          ],
          "hint": "A 16:9 backdrop for this chapter. Left blank, the chapter borrows the backdrop of the world it introduces."
        },
        {
          "id": "chapter_nodes",
          "label": "Node names \u2014 ten, in order",
          "type": "list",
          "required": true,
          "minItems": 10,
          "maxItems": 10,
          "item": {
            "id": "mnode_name",
            "label": "Node name",
            "type": "shortText",
            "maxLength": 120
          }
        }
      ]
    }
  ],
