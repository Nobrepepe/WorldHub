{
  "format": "world-hub-application-contract",
  "contractFormatVersion": 1,
  "appType": "sticker-album.collection",
  "name": "Sticker Album — Collection",
  "description": "One sticker collection: its member characters, their ten ordered sticker slots, and the pack catalog. Slot rarity is fixed by position — slots 1–3 common, 4–6 uncommon, 7–8 rare, 9 epic, 10 legendary. A sticker's stable identity is its character plus its slot number, so reordering characters never changes ownership.",
  "supportedProtocolVersions": [
    1,
    2
  ],
  "productionFields": [
    {
      "id": "collection_title",
      "label": "Collection title",
      "type": "shortText",
      "required": true,
      "maxLength": 120
    },
    {
      "id": "collection_description",
      "label": "Collection description",
      "type": "multilineText",
      "required": false,
      "maxLength": 2000
    },
    {
      "id": "theme_color",
      "label": "Theme color",
      "type": "color",
      "required": false,
      "hint": "Tints the collection's album pages."
    },
    {
      "id": "collection_order",
      "label": "Display order",
      "type": "integer",
      "required": false,
      "min": 0,
      "max": 999,
      "hint": "Lower numbers appear first when several collections are installed."
    },
    {
      "id": "packs",
      "label": "Packs",
      "type": "list",
      "required": false,
      "maxItems": 20,
      "hint": "The purchasable packs for this collection.",
      "fields": [
        {
          "id": "pack_name",
          "label": "Pack name",
          "type": "shortText",
          "required": true,
          "maxLength": 80
        },
        {
          "id": "pack_description",
          "label": "Pack description",
          "type": "multilineText",
          "required": false,
          "maxLength": 500
        },
        {
          "id": "pack_price",
          "label": "Price (cents)",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000000,
          "hint": "Minor currency units: 250 is 2.50."
        },
        {
          "id": "pack_foil_rate",
          "label": "Foil rate",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 1,
          "hint": "Chance (0–1) that a pulled sticker is foil."
        },
        {
          "id": "pack_image",
          "label": "Pack art",
          "type": "assetRef",
          "required": false,
          "assetKinds": [
            "image"
          ],
          "recipes": [
            "tile_16x9"
          ]
        },
        {
          "id": "pack_distribution",
          "label": "Distribution",
          "type": "list",
          "required": true,
          "minItems": 1,
          "maxItems": 10,
          "hint": "What a pack contains, drawn in order.",
          "fields": [
            {
              "id": "dist_selector",
              "label": "Rarity pool",
              "type": "enum",
              "required": true,
              "options": [
                {
                  "value": "common",
                  "label": "Common only"
                },
                {
                  "value": "uncommon",
                  "label": "Uncommon only"
                },
                {
                  "value": "rare",
                  "label": "Rare only"
                },
                {
                  "value": "epic",
                  "label": "Epic only"
                },
                {
                  "value": "legendary",
                  "label": "Legendary only"
                },
                {
                  "value": "standard",
                  "label": "Standard (common + uncommon)"
                },
                {
                  "value": "rare+",
                  "label": "Rare or better"
                },
                {
                  "value": "epic+",
                  "label": "Epic or better"
                },
                {
                  "value": "any",
                  "label": "Any rarity"
                }
              ]
            },
            {
              "id": "dist_quantity",
              "label": "Stickers drawn",
              "type": "integer",
              "required": true,
              "min": 1,
              "max": 20
            }
          ]
        }
      ]
    }
  ],
  "entitySelections": [
    {
      "id": "album_characters",
      "label": "Characters",
      "entityTypes": [
        "character"
      ],
      "min": 1,
      "ordered": true,
      "hint": "The characters whose stickers make up this collection, in album order.",
      "fields": [],
      "assetSets": [
        {
          "id": "char_tile",
          "label": "Character tile",
          "kinds": [
            "image"
          ],
          "roles": [
            "character.tile"
          ],
          "recipes": [
            "tile_16x9",
            "thumbnail_square"
          ],
          "min": 1,
          "max": 1,
          "hint": "16:9 banner used on the home page and in the collection's character list."
        },
        {
          "id": "char_full_body",
          "label": "Character full body",
          "kinds": [
            "image"
          ],
          "roles": [
            "character.full_body"
          ],
          "recipes": [
            "full_body_9x16",
            "thumbnail_square"
          ],
          "min": 1,
          "max": 1,
          "hint": "9:16 art shown for the favorite character and for the selected character in a collection."
        },
        {
          "id": "stickers",
          "label": "Sticker slots — ten, in order",
          "kinds": [
            "image"
          ],
          "roles": [
            "character.collectible"
          ],
          "recipes": [
            "square",
            "thumbnail_square"
          ],
          "exact": 10,
          "hint": "Slot rarity is fixed by position: 1–3 common, 4–6 uncommon, 7–8 rare, 9 epic, 10 legendary.",
          "itemFields": [
            {
              "id": "sticker_name",
              "label": "Sticker name",
              "type": "shortText",
              "required": true,
              "maxLength": 80
            },
            {
              "id": "sticker_flavor",
              "label": "Flavor text",
              "type": "multilineText",
              "required": false,
              "maxLength": 400
            },
            {
              "id": "sticker_sound",
              "label": "Voice line",
              "type": "assetRef",
              "required": false,
              "assetKinds": [
                "audio"
              ],
              "hint": "Optional sound played when the sticker's flavor text is read."
            }
          ]
        }
      ]
    }
  ],
  "assetSets": [
    {
      "id": "collection_cover",
      "label": "Collection cover",
      "kinds": [
        "image"
      ],
      "roles": [
        "world.cover"
      ],
      "recipes": [
        "tile_16x9"
      ],
      "min": 0,
      "max": 1
    }
  ],
  "documents": {
    "mode": "none"
  },
  "requiredRecipes": [
    "square",
    "thumbnail_square",
    "tile_16x9",
    "full_body_9x16"
  ]
}
