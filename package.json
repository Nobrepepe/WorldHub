{
  "name": "world-hub",
  "productName": "World Hub",
  "version": "1.0.0",
  "description": "Local-first desktop authoring and distribution system for fictional worlds, characters, documents, and artwork.",
  "author": "Felipe Nobre",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "check": "npm test && node scripts/integrity-smoke.mjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "dev.felipenobre.worldhub",
    "productName": "World Hub",
    "files": [
      "electron/**/*",
      "src/**/*",
      "schemas/**/*",
      "migrations/**/*",
      "assets/**/*",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller@5.4.0": true
  }
}
